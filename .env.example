# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google OAuth + Drive ─────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com/apis/credentials
# Also configure redirect URI in both Google Console AND Supabase Auth settings
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret   # server only (Netlify), never in the browser

# ─── Encryption of the Google Drive key (server only) ─────────────────────────
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Changing it later disconnects Drive for everyone (they reconnect once in Settings).
QIPU_TOKEN_KEY=your-32-byte-base64-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # Change to your Netlify URL in production
NEXT_PUBLIC_DEFAULT_LOCALE=es               # es | en
